# Local Docker Compose publishes only to loopback by default.
HOST_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=

# Empty uses same-origin API routing through Vite or Nginx.
VITE_API_BASE_URL=

# Dashboard alert thresholds (percent, 1-100).
VITE_CPU_WARNING_THRESHOLD=85
VITE_MEMORY_WARNING_THRESHOLD=85
VITE_DISK_WARNING_THRESHOLD=90

# Optional host-run agent MQTT settings; leave broker empty to disable.
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=embedded-monitoring/telemetry